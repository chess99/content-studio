{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-video-factory.local/schemas/script.schema.json",
  "title": "Narration Script",
  "type": "object",
  "required": ["status", "scenes"],
  "properties": {
    "status": {
      "enum": ["draft", "approved"]
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "displayText", "speechText", "sourceIds"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "displayText": {
            "type": "string"
          },
          "speechText": {
            "type": "string"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "emphasis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
