{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-video-factory.local/schemas/brief.schema.json",
  "title": "Video Brief",
  "type": "object",
  "required": [
    "status",
    "platform",
    "audience",
    "targetSeconds",
    "coreQuestion",
    "thesis",
    "tone",
    "aspectRatio"
  ],
  "properties": {
    "status": {
      "enum": ["draft", "approved"]
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string"
    },
    "targetSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "coreQuestion": {
      "type": "string"
    },
    "thesis": {
      "type": "string"
    },
    "tone": {
      "type": "string"
    },
    "aspectRatio": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
